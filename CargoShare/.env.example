# CargoShare local development configuration
# Copy this file to .env before running Docker Compose.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:8080

# PostgreSQL (Compose also uses the POSTGRES_* values)
POSTGRES_USER=cargoshare
POSTGRES_PASSWORD=cargoshare_dev_password
POSTGRES_DB=cargoshare
DATABASE_URL=postgres://cargoshare:cargoshare_dev_password@localhost:5432/cargoshare

# Redis and booking reservations
REDIS_URL=redis://localhost:6379
LOCK_TTL_SECONDS=600

# Authentication — replace this value outside local development
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

# Marketplace fees and Razorpay sandbox
PLATFORM_COMMISSION_PCT=2.5
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=cargoshare
MINIO_SECRET_KEY=cargoshare_dev_minio
MINIO_BUCKET_DOCS=cargoshare-docs
MINIO_BUCKET_INVOICES=cargoshare-invoices
MINIO_BUCKET_CHAT=cargoshare-chat

# Optional SMS provider. Leave blank to log OTPs during development.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=CRGOSH

# Optional browser API endpoint used at frontend build time
VITE_API_URL=http://localhost:4000

# Local Grafana login
GRAFANA_PASSWORD=cargoshare-admin
